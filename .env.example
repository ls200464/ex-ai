# ── Database ──────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./exskill.db
# PostgreSQL (production / Docker):
# DATABASE_URL=postgresql+asyncpg://exskill:exskill_dev@localhost:5432/exskill

# ── LLM ───────────────────────────────────────────────
# Provider: deepseek | claude | openai
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# DeepSeek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# ── Embeddings ─────────────────────────────────────────
# Provider: openai | voyage
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Voyage (used when EMBEDDING_PROVIDER=voyage)
VOYAGE_API_KEY=vp-...

# ── Auth (JWT) ─────────────────────────────────────────
JWT_SECRET_KEY=generate-a-random-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
